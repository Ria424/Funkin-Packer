{
  "ATLAS": {
    "SPRITES": [
      {{#rects}}
      {
        "SPRITE": {
          "name": "{{{name}}}",
          "x": {{frame.x}},
          "y": {{frame.y}},
          "w": {{frame.w}},
          "h": {{frame.h}},
          "rotated": {{rotated}}
        }
      }{{^last}},{{/last}}
      {{/rects}}
    ]
  },
  "meta": {
    "app": "{{{appInfo.url}}}",
    "version": "{{appInfo.version}}",
    "image": "{{config.imageFile}}",
    "format": "{{config.format}}",
    "size": {
      "w": {{config.imageWidth}},
      "h": {{config.imageHeight}}
    },
    "resolution": "{{config.scale}}"
  }
}